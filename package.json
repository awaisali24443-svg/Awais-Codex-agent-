{
  "name": "awais-codex-agent",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx server/main.ts",
    "build": "esbuild server/main.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test --test-force-exit server/*.test.ts server/*/*.test.ts",
    "db:migrate": "tsx server/migrate-cli.ts",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.0",
    "sharp": "^0.35.4",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "ws": "^8.21.3"
  },
  "description": "Autonomous AI engineering agent and WhatsApp assistant workspace powered strictly by Google Antigravity Preview",
  "author": "Awais Ali (awaisali24443-svg)",
  "license": "MIT"
}

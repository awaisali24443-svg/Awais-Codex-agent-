# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GITHUB INTEGRATION:
# GITHUB_TOKEN / GITHUB_PAT: GitHub Personal Access Token (supports both fine-grained and classic PATs).
# If set in backend environment variables, GitHub export works automatically without requiring token input in UI.
GITHUB_TOKEN=
GITHUB_PAT=

# WHATSAPP INTEGRATION:
# WHATSAPP_AGENT_KEY: Pairing key generated inside WhatsApp app (e.g. wa_agent_xxxxxxxx)
WHATSAPP_AGENT_KEY=
WHATSAPP_AGENT_NAME="Awais Codex"
WHATSAPP_AGENT_ID=

# WHATSAPP_API_KEY: Meta System User Token or WhatsApp Agent API key.
WHATSAPP_API_KEY=

# WHATSAPP_PHONE_NUMBER_ID: The WhatsApp Phone Number ID / Agent ID.
WHATSAPP_PHONE_NUMBER_ID=

# WHATSAPP_VERIFY_TOKEN: Secret string for webhook verification handshake.
WHATSAPP_VERIFY_TOKEN="awais_codex_verify_token"

# WHATSAPP_ADMIN_SECRET: Shared secret to authenticate WhatsApp admin & API management endpoints.
WHATSAPP_ADMIN_SECRET="wa_admin_secret_change_me_in_prod"

# WHATSAPP_APP_SECRET: Meta App Secret for validating Meta webhook X-Hub-Signature-256 HMAC signatures.
WHATSAPP_APP_SECRET=""

# ANTIGRAVITY ENGINE CONFIGURATION:
# GEMINI_API_KEY: Required for Google Antigravity preview model (antigravity-preview-05-2026).
# Obtain this key from Google AI Studio (https://aistudio.google.com/).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this server is hosted (e.g. https://your-domain.com or http://localhost:3000).
APP_URL="MY_APP_URL"

# GITHUB INTEGRATION:
# GITHUB_TOKEN / GITHUB_PAT: GitHub Personal Access Token (supports fine-grained and classic PATs).
# If set, GitHub export commits & creates repos directly without needing token entry in the browser UI.
GITHUB_TOKEN=
GITHUB_PAT=

# WHATSAPP INTEGRATION (Personal Use / Open Tunnel Mode):
# WHATSAPP_AGENT_KEY: Pairing key generated inside WhatsApp agent tunnel (e.g. wa_agent_xxxxxxxx)
WHATSAPP_AGENT_KEY=
WHATSAPP_AGENT_NAME="Awais Codex"
WHATSAPP_AGENT_ID=

# WHATSAPP_API_KEY: Meta Cloud API System User Access Token (optional if using pairing tunnel).
WHATSAPP_API_KEY=

# WHATSAPP_PHONE_NUMBER_ID: Meta Phone Number ID (optional if using pairing tunnel).
WHATSAPP_PHONE_NUMBER_ID=

# WHATSAPP_VERIFY_TOKEN: Token for Meta Cloud API Webhook verification handshake.
WHATSAPP_VERIFY_TOKEN="awais_codex_verify_token"

# WHATSAPP_ADMIN_SECRET: Admin secret (optional: open by default for personal use).
WHATSAPP_ADMIN_SECRET="wa_admin_secret_change_me_in_prod"

# WHATSAPP_APP_SECRET: Meta App Secret for validating webhook HMAC signatures (optional).
WHATSAPP_APP_SECRET=""

# =============================================================================
# AWAIS CODEX — environment
# Copy to `.env` and fill in. Never commit `.env`.
# =============================================================================

# ---------------------------------------------------------------------------
# DATABASE (required in production)
# ---------------------------------------------------------------------------
# Neon's *pooled* connection string (host contains "-pooler").
# Neon dashboard -> your project -> Connection string -> "Pooled connection".
# Needed because Render's free disk is ephemeral: any state stored in a file is
# erased on every spin-down, restart, and deploy.
# Leave empty locally to use PGlite (in-process Postgres, dev/test only).
DATABASE_URL=""

# ---------------------------------------------------------------------------
# SECRETS (required in production)
# ---------------------------------------------------------------------------
# Signs session cookies. Generate: openssl rand -base64 48
SESSION_SECRET=""

# Encrypts stored API tokens (AES-256-GCM). Must be 64 hex chars.
# Generate: openssl rand -hex 32
# WARNING: changing this makes every stored secret unreadable.
MASTER_KEY=""

# ---------------------------------------------------------------------------
# GOOGLE ANTIGRAVITY AGENT
# ---------------------------------------------------------------------------
# Google AI Studio key (https://aistudio.google.com/apikey).
# Optional: the web UI can also supply a key, which is stored encrypted.
GEMINI_API_KEY=""

# ---------------------------------------------------------------------------
# WHATSAPP AGENT PLATFORM (third-party agent feature)
# ---------------------------------------------------------------------------
# From WhatsApp on your phone:
#   Settings -> Agents -> Create an agent -> open its chat
#   -> Chat info -> API key
# Treat it as a password. A rotated or stale key returns 400/code 100,
# which looks like a bad request rather than an auth error.
WHATSAPP_TOKEN=""

# Exactly ONE process may long-poll a given agent. A second poller kills the
# first with 409 PollReplacedError. Set to true on whichever host owns the
# poller (your laptop OR Render, never both).
POLLER_ENABLED="false"

# ---------------------------------------------------------------------------
# QUOTA & RETENTION
# ---------------------------------------------------------------------------
# Free tier: ~100 Antigravity runs/day. Enforced server-side, not decorative.
DAILY_RUN_BUDGET="100"
# Replayable run events are append-only; Neon free tier is 0.5 GB.
EVENT_RETENTION_DAYS="14"
# Artifacts live on an ephemeral disk, so this is a safety net, not storage.
ARTIFACT_RETENTION_DAYS="7"

# ---------------------------------------------------------------------------
# GITHUB EXPORT (optional)
# ---------------------------------------------------------------------------
GITHUB_TOKEN=""

# ---------------------------------------------------------------------------
# SERVER
# ---------------------------------------------------------------------------
NODE_ENV="development"
PORT="3000"
# Public base URL, for links in WhatsApp replies.
APP_URL=""
